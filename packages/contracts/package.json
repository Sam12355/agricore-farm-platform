{
  "name": "@agricore/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Single source of truth for the AgriCore API surface: Zod schemas, derived types and the OpenAPI generator.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "generated"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ./dist/openapi/generate.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "openapi": "node ./dist/openapi/generate.js"
  },
  "dependencies": {
    "@agricore/shared-types": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^8.57.1",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
