{
  "name": "@guardianlink/design-tokens",
  "version": "0.1.0",
  "private": true,
  "description": "GuardianLink design tokens with generators for CSS custom properties, Swift and Kotlin.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "generated"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ./dist/generate.js",
