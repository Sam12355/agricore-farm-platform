{
  "$comment": "AgriCore design tokens.  Generated from packages/design-tokens/src/tokens.ts. Do not edit by hand: run `pnpm --filter @agricore/design-tokens build` instead.",
  "color": {
    "surface-base": {
      "light": "#ffffff",
      "dark": "#0d1117",
      "description": "Page background"
    },
    "surface-raised": {
      "light": "#f5f7fa",
      "dark": "#161b22",
      "description": "Cards, panels, sheets"
    },
    "surface-sunken": {
      "light": "#e9edf3",
      "dark": "#010409",
      "description": "Wells, code blocks, map chrome"
    },
    "surface-overlay": {
      "light": "#ffffff",
      "dark": "#1c2128",
      "description": "Modals and popovers"
    },
    "text-primary": {
      "light": "#12161c",
      "dark": "#e6edf3",
      "description": "Body copy and headings"
    },
    "text-secondary": {
      "light": "#4a5462",
      "dark": "#9198a1",
      "description": "Supporting copy and labels"
    },
    "text-inverse": {
      "light": "#ffffff",
      "dark": "#0d1117",
      "description": "Text on a filled brand or danger surface"
    },
    "text-disabled": {
      "light": "#767f8c",
      "dark": "#6e7681",
      "description": "Disabled control labels"
    },
    "brand-primary": {
      "light": "#0b5f8a",
      "dark": "#3fa2d6",
      "description": "Primary actions and links"
    },
    "brand-primary-hover": {
      "light": "#084a6c",
      "dark": "#63b6e0",
      "description": "Primary action hover state"
    },
    "brand-subtle": {
      "light": "#e2f0f8",
      "dark": "#0d2c3d",
      "description": "Tinted brand background"
    },
    "status-safe": {
      "light": "#1a6b4a",
      "dark": "#4bbf8a",
      "description": "Safe, resolved, arrived"
    },
    "status-safe-subtle": {
      "light": "#e3f4ec",
      "dark": "#0e2a1f",
      "description": "Safe state background"
    },
    "status-caution": {
      "light": "#8a5a00",
      "dark": "#e0aa42",
      "description": "Session overdue, degraded, pending"
    },
    "status-caution-subtle": {
      "light": "#fdf1dc",
      "dark": "#33260a",
      "description": "Caution state background"
    },
    "status-critical": {
      "light": "#a51f2b",
      "dark": "#f0616d",
      "description": "Active alert. Used nowhere else"
    },
    "status-critical-subtle": {
      "light": "#fdeaec",
      "dark": "#3d1116",
      "description": "Active alert background"
    },
    "status-neutral": {
      "light": "#4a5462",
      "dark": "#9198a1",
      "description": "Cancelled, archived, inactive"
    },
    "border-default": {
      "light": "#d3dae3",
      "dark": "#30363d",
      "description": "Dividers and input borders"
    },
    "border-strong": {
      "light": "#6b7684",
      "dark": "#6e7681",
      "description": "Emphasised borders and input outlines"
    },
    "focus-ring": {
      "light": "#0b5f8a",
      "dark": "#63b6e0",
      "description": "Keyboard focus indicator. Never removed, only restyled"
    }
