# Without this, `COPY packages/ packages/` copies the host's node_modules over the ones
# pnpm installed in the image. The host's are a tree of symlinks into the host .pnpm store,
# which does not exist in the container, so the build fails with "cannot find module
# typescript/bin/tsc" from a directory that visibly contains typescript.
#
# That failure took a build to diagnose and is the reason this file exists.
node_modules
**/node_modules

# Build output. Rebuilt inside the image; copying a host build in would mask a broken build.
dist
build
.next
**/*.tsbuildinfo

# Never in an image
.env
.env.*
!.env.example
*.pem
*.p12
*.p8
*.keystore
*.jks
*.mobileprovision
google-services.json
GoogleService-Info.plist
service-account*.json

# Not needed at build time, and .git is large
.git
.github
coverage
playwright-report
test-results
docs
*.md
!README.md

# Native app sources are not part of the API image
apps/ios
apps/android

# Infrastructure definitions are not part of the runtime
infrastructure/terraform
