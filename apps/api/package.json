{
  "name": "@agricore/api",
  "version": "0.1.0",
  "private": true,
  "description": "AgriCore backend. Modular monolith on NestJS with REST, GraphQL and Socket.IO.",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test --ext .ts",
    "test": "jest --config jest.config.js --selectProjects unit integration",
    "test:unit": "jest --config jest.config.js --selectProjects unit",
    "test:integration": "jest --config jest.config.js --selectProjects integration",
    "test:e2e": "jest --config jest.config.js --selectProjects e2e --runInBand",
    "test:all": "jest --config jest.config.js --runInBand",
    "test:cov": "jest --config jest.config.js --coverage --runInBand",
    "seed": "ts-node -T src/seed/seed.ts",
    "openapi:emit": "ts-node -T src/scripts/emit-openapi.ts"
  },
  "dependencies": {
    "@agricore/contracts": "workspace:*",
    "@agricore/shared-types": "workspace:*",
    "@agricore/test-fixtures": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/websockets": "^10.4.15",
    "@nestjs/graphql": "^12.2.2",
    "@nestjs/apollo": "^12.2.2",
    "@apollo/server": "^4.11.3",
    "graphql": "^16.10.0",
    "graphql-subscriptions": "^3.0.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "mongodb": "^6.12.0",
    "pg": "^8.13.1",
    "jsonwebtoken": "^9.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
