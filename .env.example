# AgriCore configuration example.
#
# Copy to .env and fill in. Every value here is a placeholder. Nothing in this file is a
# real credential and nothing real should ever be committed to it.
#
# Generate the three signing secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Run it three times. They must all be different: the config schema refuses to start if
# any two match, because that would make a worker-view link and an access token
# interchangeable except for a claim check.

NODE_ENV=development
PORT=3001
LOG_LEVEL=info
SERVICE_NAME=agricore-api

PUBLIC_WEB_ORIGIN=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Signing secrets. Minimum 32 characters, all distinct. -----------------------
JWT_ACCESS_SECRET=replace-with-32-plus-random-characters-aaaa
JWT_REFRESH_SECRET=replace-with-32-plus-random-characters-bbbb
JWT_WORKER_VIEW_SECRET=replace-with-32-plus-random-characters-cccc
JWT_ISSUER=agricore
JWT_AUDIENCE=agricore-clients
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# --- Adapter selection ----------------------------------------------------------
# The defaults need nothing installed: `pnpm dev` and `pnpm test` both work as-is.
# Switching any of these to a real backend is the only change needed to run against
# real infrastructure; no application code is conditional on it.
PERSISTENCE=memory              # memory | postgres
TELEMETRY_STORE=memory          # memory | mongodb
CACHE=memory                    # memory | redis
NOTIFICATION_TRANSPORT=inprocess # inprocess | sqs
EMAIL_PROVIDER=console          # console | smtp | ses
SMS_PROVIDER=mock               # mock | sns
PUSH_PROVIDER=mock              # mock | apns | fcm
OBJECT_STORE=memory             # memory | s3

# --- Connection strings. Required only when the matching adapter is selected. ----
# The config schema enforces that: PERSISTENCE=postgres with no DATABASE_URL refuses to
# start rather than failing on the first query.
DATABASE_URL=postgres://agricore:agricore@localhost:5432/agricore
MONGODB_URI=mongodb://localhost:27017/agricore
REDIS_URL=redis://localhost:6379
SQS_QUEUE_URL=
S3_BUCKET=
AWS_REGION=eu-west-1

# --- Limits ---------------------------------------------------------------------
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_WRITE_PER_MINUTE=60
RATE_LIMIT_READ_PER_MINUTE=240
IDEMPOTENCY_TTL_SECONDS=86400
OUTBOX_POLL_INTERVAL_MS=2000
ENABLE_BACKGROUND_WORKERS=true

# --- Web ------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
# MapLibre with OpenStreetMap-compatible tiles needs no API key. That is why it was
# chosen: the demo works for anyone who clones this, with no account anywhere.
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# --- Never put these in this file ------------------------------------------------
# APPLE_APP_STORE_CONNECT_PRIVATE_KEY
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON
# ANDROID_KEYSTORE_BASE64
# AWS_SECRET_ACCESS_KEY
# They belong in the CI secret store and in AWS Secrets Manager. See
# docs/SECURITY.md and native-release-lab/docs/SECRETS.md.
